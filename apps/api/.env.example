PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/budget-app
# Must be at least 32 random characters — generate with e.g. `openssl rand -base64 32`.
# The values below are intentionally too short to pass validation: copying this
# file to .env without replacing them will fail to boot with a clear error,
# rather than silently running with a well-known secret from this repo.
JWT_SECRET=change_this_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
CLIENT_URL=http://localhost:5173

# Password-reset email. MAIL_PROVIDER: log (prints the email in the server log,
# for development) | resend | brevo. The sender in MAIL_FROM must be verified
# with the provider (a verified address for Brevo, a verified domain for Resend).
MAIL_PROVIDER=log
MAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Budget
